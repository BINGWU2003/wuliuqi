{
  "name": "shop",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "apps": "docker build -f ../../docker/Dockerfile.app --build-arg APP_NAME=shop --build-arg APP_PORT=3000 --build-arg NEXT_PUBLIC_POSTHOG_KEY --build-arg POSTHOG_INGEST_HOST --build-arg POSTHOG_ASSET_HOST -t wuliuqi-shop:latest ../..",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vercel/analytics": "catalog:",
    "@wuliuqi/domain": "workspace:*",
    "@wuliuqi/types": "workspace:*",
    "@wuliuqi/ui": "workspace:*",
    "@wuliuqi/utils": "workspace:*",
    "@wuliuqi/validators": "workspace:*",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "posthog-js": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wuliuqi/eslint-config": "workspace:*",
    "@wuliuqi/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
