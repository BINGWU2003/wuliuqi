COS_BUCKET=
COS_REGION=
COS_PUBLIC_BASE_URL=

RAG_DATABASE_URL=
RAG_DB_POOL_SIZE=5
RAG_MODEL_PROVIDER=gemini
GEMINI_API_KEY=
