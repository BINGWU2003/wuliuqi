generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CodmAccount {
  id           BigInt    @id @default(autoincrement())
  serialNumber String    @unique @map("serial_number") @db.VarChar(50)
  images       Json?
  attributes   Json      @default("{}")
  price        Decimal   @default(0.00) @db.Decimal(10, 2)
  costPrice    Decimal   @default(0.00) @map("cost_price") @db.Decimal(10, 2)
  soldPrice    Decimal?  @map("sold_price") @db.Decimal(10, 2)
  soldAt       DateTime? @map("sold_at")
  title        String    @db.VarChar(255)
  describe     String?   @db.Text
  xianyuUrl    String?   @map("xianyu_url") @db.VarChar(512)
  email        String?   @db.VarChar(255)
  status       Int       @default(1) @db.SmallInt
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([status, updatedAt(sort: Desc)], map: "codm_accounts_status_updated_at_idx")
  @@index([email], map: "codm_accounts_email_idx")
  @@map("codm_accounts")
}

model CodmEmail {
  id         BigInt   @id @default(autoincrement())
  prefix     String   @db.VarChar(64)
  postfix    String   @db.VarChar(255)
  bindStatus Int      @default(2) @map("bind_status") @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([prefix, postfix], map: "codm_emails_address_idx")
  @@map("codm_emails")
}

model SanguoshaAccount {
  id           BigInt    @id @default(autoincrement())
  serialNumber String    @unique @map("serial_number") @db.VarChar(50)
  images       Json?
  attributes   Json      @default("{}")
  price        Decimal   @default(0.00) @db.Decimal(10, 2)
  costPrice    Decimal   @default(0.00) @map("cost_price") @db.Decimal(10, 2)
  soldPrice    Decimal?  @map("sold_price") @db.Decimal(10, 2)
  soldAt       DateTime? @map("sold_at")
  title        String    @db.VarChar(255)
  describe     String?   @db.Text
  xianyuUrl    String?   @map("xianyu_url") @db.VarChar(512)
  email        String?   @db.VarChar(255)
  status       Int       @default(1) @db.SmallInt
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([status, updatedAt(sort: Desc)], map: "sanguosha_accounts_status_updated_at_idx")
  @@index([createdAt(sort: Desc)], map: "sanguosha_accounts_created_at_idx")
  @@index([email], map: "sanguosha_accounts_email_idx")
  @@map("sanguosha_accounts")
}

model SanguoshaEmail {
  id         BigInt   @id @default(autoincrement())
  prefix     String   @db.VarChar(64)
  postfix    String   @db.VarChar(255)
  bindStatus Int      @default(2) @map("bind_status") @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([prefix, postfix], map: "sanguosha_emails_address_idx")
  @@map("sanguosha_emails")
}

model GameEmailPostfix {
  id        BigInt   @id @default(autoincrement())
  gameKey   String   @default("global") @map("game_key") @db.VarChar(50)
  postfix   String   @db.VarChar(255)
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([postfix], map: "game_email_postfixes_postfix_key")
  @@index([enabled, sortOrder], map: "game_email_postfixes_enabled_sort_idx")
  @@map("game_email_postfixes")
}

model Carousel {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  items     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("carousels")
}

model SequenceCounter {
  id           BigInt   @id @default(autoincrement())
  counterName  String   @unique @map("counter_name") @db.VarChar(50)
  currentValue BigInt   @default(0) @map("current_value")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("sequence_counters")
}

model GameAttributeDefinition {
  id        BigInt    @id @default(autoincrement())
  gameKey   String    @map("game_key") @db.VarChar(50)
  attrKey   String    @map("attr_key") @db.VarChar(80)
  label     String    @db.VarChar(80)
  type      String    @db.VarChar(20)
  unit      String?   @db.VarChar(20)
  options   Json      @default("[]")
  enabled   Boolean   @default(true)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([gameKey, attrKey], map: "game_attribute_definitions_game_attr_key")
  @@index([gameKey, enabled, sortOrder], map: "game_attribute_definitions_game_enabled_sort_idx")
  @@index([gameKey, deletedAt, enabled, sortOrder], map: "game_attribute_definitions_game_deleted_enabled_sort_idx")
  @@map("game_attribute_definitions")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("users")
}
